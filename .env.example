# Copy to .env.local and fill in. Every variable here is read in exactly one
# place — src/utils/const.js — which throws at build time if one is missing.

# --- ContioReach CMS (read API) -------------------------------------------
# Create a workspace at https://app.contioreach.com/signup, then copy the read
# key from Settings → API. Server-only: never exposed to the browser.
CMS_API_URL=https://cms-api.contioreach.com
# Ships with the read-only key of the ContioReach demo workspace, so the site
# runs straight away — with a banner across the top saying it is demo content.
# Paste your own key here and the banner goes away by itself. See "Use your own
# content" in the README.
CMS_API_KEY=cms_a77631bccba461401bf5fd25b0402acd163623af5a5fc0ca

# Shared secret your CMS sends with its publish webhook, so the app can tell a
# real invalidation from a stranger hitting POST /api/revalidate/all.
# Settings → Webhooks. Server-only.
# Optional until you deploy: generate it under Developer Settings → Webhook
# Integration. While it is empty the webhook rejects every call.
REVALIDATION_SECRET=

# --- This site -------------------------------------------------------------
# Canonical origin: canonical tags, Open Graph URLs, JSON-LD and the sitemap.
# Set it to your real domain before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines are turned away (noindex + robots.txt Disallow) unless this is
# exactly "true". Leave it false for demo deployments.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Links -----------------------------------------------------------------
NEXT_PUBLIC_SIGNUP_URL=https://app.contioreach.com/signup
NEXT_PUBLIC_LOGIN_URL=https://app.contioreach.com/login
